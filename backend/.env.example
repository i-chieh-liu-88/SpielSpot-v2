# Copy to .env and fill in your own values. Never commit actual credentials.
MONGODB_URI=
PORT=5000
CLIENT_URL=http://localhost:5173
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 0 for direct localhost. Set only after verifying the deployed proxy chain.
TRUST_PROXY_HOPS=0

# Temporary authenticated structure-only inspection; keep false normally.
PROXY_DIAGNOSTICS_ENABLED=false
